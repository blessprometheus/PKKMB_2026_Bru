# Salin ke .env.local (lokal) atau .env.production (server), JANGAN commit.

# Alamat backend Laravel untuk rewrite next.config.ts.
# Di PRODUKSI nilai ini TIDAK DIPAKAI — Nginx yang meneruskan /api/* langsung
# ke Laravel (docs/06-deployment.md §3), jadi baris ini boleh dikosongkan
# atau dihapus di .env.production.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Nama cookie sesi Laravel. WAJIB SAMA PERSIS dengan SESSION_COOKIE di
# backend/.env — dipakai proxy.ts untuk mengarahkan pengunjung yang belum
# masuk ke halaman login. Ini BUKAN pengamanan (lihat proxy.ts), hanya UX.
NEXT_PUBLIC_SESSION_COOKIE=pkkmb_session

# Domain produksi untuk metadataBase (OG/Twitter image, canonical URL).
# TODO: [D12] isi setelah domain final dikonfirmasi.
NEXT_PUBLIC_SITE_URL=https://pkkmb.uninus.ac.id

# Salin ke .env, isi nilai sebenarnya, JANGAN commit .env.
# Nilai di bawah adalah PRODUCTION-SAFE DEFAULTS untuk proyek ini — bukan
# bawaan Laravel. Lihat docs/06-deployment.md §5 dan docs/04-security.md §8.

APP_NAME="PKKMB UNINUS 2026"
APP_ENV=production
APP_KEY=
# WAJIB false di produksi — true membocorkan stack trace & kredensial DB
# ke halaman error publik (docs/04-security.md §8, checklist §11 butir 1).
APP_DEBUG=false
APP_URL=https://pkkmb.uninus.ac.id
# TODO: [D12] sesuaikan setelah domain final dikonfirmasi.

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# WAJIB Asia/Jakarta, dan HARUS SAMA dengan DB_TIMEZONE di bawah.
# Kalau berbeda, seluruh stempel waktu kehadiran bergeser diam-diam —
# lihat catatan bug Fase 4 di docs/README.md.
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# PostgreSQL, BUKAN MySQL/SQLite. User aplikasi non-superuser
# (docs/04-security.md §8, docs/06-deployment.md §5 langkah 2).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pkkmb26
DB_USERNAME=pkkmb26_app
DB_PASSWORD=
# WAJIB nama zona IANA, JANGAN offset seperti "+07:00" — PostgreSQL memakai
# konvensi POSIX yang tandanya terbalik. Lihat config/database.php.
DB_TIMEZONE=Asia/Jakarta

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_COOKIE=pkkmb_session
# WAJIB true di produksi (HTTPS) — tanpa ini cookie sesi bisa terkirim lewat
# koneksi HTTP biasa bila deteksi HTTPS gagal (mis. header X-Forwarded-Proto
# tidak diteruskan Nginx). Biarkan KOSONG di .env lokal (HTTP tanpa TLS).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@uninus.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Sanctum & frontend (docs/03-api-spec.md §1.3) ──────────────────────────
# Domain frontend yang dipercaya membuat sesi cookie. Tanpa ini login gagal
# dengan 400 "SANCTUM_STATEFUL_DOMAINS tidak cocok".
FRONTEND_URL=https://pkkmb.uninus.ac.id
SANCTUM_STATEFUL_DOMAINS=pkkmb.uninus.ac.id

# IP Nginx di depan aplikasi. Tanpa ini SELURUH rate limit melihat semua
# pengunjung sebagai satu IP (docs/06-deployment.md §3).
TRUSTED_PROXIES=127.0.0.1

# ── Saklar keamanan cadangan (docs/04-security.md §2) ──────────────────────
# Nyalakan jadi true tanpa deploy ulang bila terdeteksi penyapuan NIM saat acara.
LOOKUP_REQUIRE_BIRTHDATE=false
LOOKUP_RATE_PER_MINUTE=10
LOOKUP_RATE_PER_HOUR=40

VITE_APP_NAME="${APP_NAME}"

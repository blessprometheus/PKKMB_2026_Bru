# === Rahasia & konfigurasi ===
.env
.env.*
!.env.example

# === Data pribadi mahasiswa — JANGAN PERNAH di-commit ===
# Lihat docs/04-security.md §10
*.xlsx
*.xls
*.csv
*.sql
*.dump
backend/storage/app/imports/
backend/storage/app/private/
public/uploads/

# === Dependensi & build ===
node_modules/
vendor/
.next/
out/
build/
dist/

# === Laravel ===
# Yang diabaikan ISINYA, bukan foldernya. Laravel gagal total ("bootstrap/cache
# directory must be present and writable") bila folder ini tidak ada, dan git
# tidak menyimpan folder kosong — jadi tiap folder menyimpan satu .gitignore
# penanda. Ditemukan 24 Sep 2026 saat clone pertama di server.
backend/storage/*.key
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore

# === Artefak yang tidak berhubungan dengan proyek ===
opencode/
opencode.zip

# === Editor & OS ===
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log

# === Dokumen panitia bertanda CONFIDENTIAL ===
# Lihat bahan/README.md §2. Berkasnya tetap ada di mesin lokal, tapi tidak
# ikut terbawa bila repositori ini dipasang di GitHub/GitLab atau dibagikan.
# Fakta yang dibutuhkan proyek sudah dirangkum di bahan/README.md §4.
bahan/dokumen/*.pdf
